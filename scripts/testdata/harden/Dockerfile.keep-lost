# Run with a kit whose ca-keep.list also keeps an intermediate whose root is
# in no bundle (scripts/test-harden.sh makes that kit): the build must fail,
# because a kept chain does not verify after the module runs.
FROM debian:bookworm-slim
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends ca-certificates openssl >/dev/null
RUN --mount=type=bind,from=harden,target=/harden sh /harden/harden.sh
