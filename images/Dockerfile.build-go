ARG GOLANG_VERSION=1.26.6
FROM golang:$GOLANG_VERSION AS go-downloader
# A transient stream reset from proxy.golang.org must cost a re-request, not
# the whole publish (three v0.1.16 attempts died that way -- run 32405801237).
# The | separator falls back to the next entry on ANY error -- including a
# reset mid-download, verified empirically -- and Go does not dedupe the list,
# so listing the same proxy three times is a native two-shot retry against
# itself. No `direct` tail: VCS fallback would hit GitHub rate limits and can
# only serve a strict subset of what the proxy serves. Builder stage only --
# the final image's GOPROXY is downstream users' business, not ours.
ENV GOPROXY="https://proxy.golang.org|https://proxy.golang.org|https://proxy.golang.org"

ARG GO_BINDATA_VERSION
RUN go install "github.com/go-bindata/go-bindata/v3/go-bindata@v${GO_BINDATA_VERSION}"
# Transitive pins for the from-source tool builds below (central values in
# common.config.mk; see /scout-fix section C).
ARG X_CRYPTO_VERSION
ARG X_NET_VERSION
ARG X_SYS_VERSION
ARG X_MOD_VERSION
ARG GO_TESTSUM_VERSION
# Built from source (not `go install`) so we can pin patched golang.org/x/sys
# (CVE-2026-39824) and golang.org/x/mod (CVE-2026-56864 / CVE-2026-56865, pulled
# in transitively via x/tools); gotestsum otherwise bundles vulnerable versions.
# Trade-off: `gotestsum --version` reports "(devel)" — it has no version ldflag
# and derives its version from the main module.
RUN mkdir /tmp/gotestsum && cd /tmp/gotestsum && \
    go mod init _gotestsum && \
    go get "gotest.tools/gotestsum@v${GO_TESTSUM_VERSION}" golang.org/x/mod@v${X_MOD_VERSION} golang.org/x/sys@v${X_SYS_VERSION} && \
    go build -o /go/bin/gotestsum "gotest.tools/gotestsum" && \
    cd / && rm -rf /tmp/gotestsum
ARG GOLANGCI_LINT_VERSION
# Built from source (not `go install`) so we can pin patched golang.org/x/sys
# (CVE-2026-39824) and golang.org/x/mod (CVE-2026-56864 / CVE-2026-56865, via
# x/tools); golangci-lint otherwise bundles x/sys 0.42.0 and a vulnerable x/mod.
# The ldflags preserve `--version` (golangci-lint uses build-info only when
# main.date is empty).
RUN mkdir /tmp/golangci && cd /tmp/golangci && \
    go mod init _golangci && \
    go get "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v${GOLANGCI_LINT_VERSION}" golang.org/x/mod@v${X_MOD_VERSION} golang.org/x/sys@v${X_SYS_VERSION} && \
    go build -ldflags "-X main.version=${GOLANGCI_LINT_VERSION} -X main.commit=unknown -X main.date=unknown" \
      -o /go/bin/golangci-lint "github.com/golangci/golangci-lint/v2/cmd/golangci-lint" && \
    cd / && rm -rf /tmp/golangci
ARG GIT_LFS_VERSION
# git-lfs bundles a vulnerable golang.org/x/net and x/crypto; pin the patched
# x/net (CVE-2026-46600, fixed in 0.56.0) and x/crypto (CVE-2026-56854 /
# CVE-2026-78662 / CVE-2026-56855, fixed in 0.56.0), plus the x/sys they
# coordinate with. x/crypto@0.56.0 requires x/net >= 0.57.0, satisfied by
# the shared X_NET_VERSION floor.
RUN mkdir /tmp/gitlfs && cd /tmp/gitlfs && \
    go mod init _gitlfs && \
    go get "github.com/git-lfs/git-lfs/v3@v${GIT_LFS_VERSION}" golang.org/x/crypto@v${X_CRYPTO_VERSION} golang.org/x/net@v${X_NET_VERSION} golang.org/x/sys@v${X_SYS_VERSION} && \
    go build -o /go/bin/git-lfs "github.com/git-lfs/git-lfs/v3" && \
    cd / && rm -rf /tmp/gitlfs

ARG GRPC_VERSION
ARG DOCKER_CLI_VERSION
# Built from source, not the download.docker.com static tarball: Docker builds
# its published CLI with whatever Go release it happened to use (29.6.1 is
# stamped go1.26.4, and even the current 29.7.2 only go1.26.5), so the six
# stdlib CVEs fixed in Go 1.26.6 ride along in the prebuilt binary and no
# DOCKER_CLI_VERSION bump can clear them -- CVE-2026-33818, -39821, -46600,
# -56853, -56859 and -56862 (#115). Building here links the GOLANG_VERSION
# stdlib instead, and picks up x/text 0.41.0, so it needs no extra golang.org/x
# pins beyond the grpc-driven x/net bump below. CGO_ENABLED=0 with osusergo,netgo
# keeps the binary static (as the tarball was) and avoids a gcc/musl-dev
# dependency in the Alpine variants; the ldflags preserve `docker --version`.
# docker/cli transitively pulls google.golang.org/grpc 1.83.1, vulnerable to
# CVE-2026-84445 (xDS array-index DoS, affects >=1.83.0 <1.83.2), so grpc is
# pinned to the patched 1.83.2 (which also raises x/net to its 0.58.0 floor).
# Drop the pin once docker/cli requires it.
RUN mkdir /tmp/dockercli && cd /tmp/dockercli && \
    go mod init _dockercli && \
    go get "github.com/docker/cli/cmd/docker@v${DOCKER_CLI_VERSION}" google.golang.org/grpc@v${GRPC_VERSION} && \
    CGO_ENABLED=0 go build -tags "grpcnotrace,osusergo,netgo" \
      -ldflags "-X github.com/docker/cli/cli/version.Version=${DOCKER_CLI_VERSION} -X github.com/docker/cli/cli/version.GitCommit=unknown -X github.com/docker/cli/cli/version.BuildTime=unknown -X github.com/docker/cli/cli/version.PlatformName=Docker" \
      -o /go/bin/docker "github.com/docker/cli/cmd/docker" && \
    cd / && rm -rf /tmp/dockercli

FROM golang:$GOLANG_VERSION

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      libltdl-dev curl make rsync zip jq tini ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# Docker CLI, built from source in the go-downloader stage above --
# the published static tarball carries an unpatched Go stdlib (#115).
COPY --from=go-downloader /go/bin/docker /usr/local/bin/docker
RUN docker --version

COPY --from=go-downloader /go/bin/go-bindata /go/bin/go-bindata
COPY --from=go-downloader /go/bin/gotestsum /go/bin/gotestsum
COPY --from=go-downloader /go/bin/golangci-lint /go/bin/golangci-lint
COPY --from=go-downloader /go/bin/git-lfs /go/bin/git-lfs

ENV GOCACHE=/tmp

# set up private repo access for go mod
RUN git config --system url."git@github.com:luthersystems/license.git".insteadOf "https://github.com/luthersystems/license"; \
  git config --system url."git@github.com:luthersystems/substrate.git".insteadOf "https://github.com/luthersystems/substrate"; \
  git config --system url."git@github.com:luthersystems/chainidentifier.git".insteadOf "https://github.com/luthersystems/chainidentifier"; \
  ssh-keyscan -t Ed25519 -H bitbucket.org | tee -a /etc/ssh/ssh_known_hosts; \
  ssh-keyscan -t Ed25519 -H github.com | tee -a /etc/ssh/ssh_known_hosts

# Default to a non-root user (Docker Scout "default non-root user" policy).
# Like build-api, this image is consumed via `docker run`, and its
# workspace-mounting consumers pass `-u $(id -u):$(id -g)`, which overrides this
# default and keeps working — the tools in /go/bin are world-executable. /go is
# mode 1777 in the golang image and GOCACHE=/tmp, so module/build-cache writes
# succeed for a non-root uid; HOME is writable for tooling that touches $HOME.
# Added when build-go joined the grade-A required set (#75).
RUN useradd --create-home --uid 1000 --user-group build
ENV HOME=/home/build
USER build
ENTRYPOINT ["tini", "--"]
