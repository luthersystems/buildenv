ARG NODE_VERSION=20.19.3
ARG GOLANG_VERSION=1.26.6
FROM golang:$GOLANG_VERSION AS docker-cli-builder
# A transient stream reset from proxy.golang.org must cost a re-request, not
# the whole publish (three v0.1.16 attempts died that way -- run 32405801237).
# The | separator falls back to the next entry on ANY error -- including a
# reset mid-download, verified empirically -- and Go does not dedupe the list,
# so listing the same proxy three times is a native two-shot retry against
# itself. No `direct` tail: VCS fallback would hit GitHub rate limits and can
# only serve a strict subset of what the proxy serves. Builder stage only --
# the final image's GOPROXY is downstream users' business, not ours.
ENV GOPROXY="https://proxy.golang.org|https://proxy.golang.org|https://proxy.golang.org"
ARG DOCKER_CLI_VERSION
# Built from source, not the download.docker.com static tarball: Docker builds
# its published CLI with whatever Go release it happened to use (29.6.1 is
# stamped go1.26.4, and even the current 29.7.2 only go1.26.5), so the six
# stdlib CVEs fixed in Go 1.26.6 ride along in the prebuilt binary and no
# DOCKER_CLI_VERSION bump can clear them -- CVE-2026-33818, -39821, -46600,
# -56853, -56859 and -56862 (#115). Building here links the GOLANG_VERSION
# stdlib instead, and picks up x/net 0.57.0 + x/text 0.41.0, so it needs no
# extra golang.org/x pins. CGO_ENABLED=0 with osusergo,netgo keeps the binary
# static (as the tarball was) and avoids a gcc/musl-dev dependency in the
# Alpine variants; the ldflags preserve `docker --version`.
RUN mkdir /tmp/dockercli && cd /tmp/dockercli && \
    go mod init _dockercli && \
    go get "github.com/docker/cli/cmd/docker@v${DOCKER_CLI_VERSION}" && \
    CGO_ENABLED=0 go build -tags "grpcnotrace,osusergo,netgo" \
      -ldflags "-X github.com/docker/cli/cli/version.Version=${DOCKER_CLI_VERSION} -X github.com/docker/cli/cli/version.GitCommit=unknown -X github.com/docker/cli/cli/version.BuildTime=unknown -X github.com/docker/cli/cli/version.PlatformName=Docker" \
      -o /go/bin/docker "github.com/docker/cli/cmd/docker" && \
    cd / && rm -rf /tmp/dockercli

FROM ubuntu:24.04 AS aws

RUN apt-get update
RUN apt-get install --no-install-recommends -y gnupg curl ca-certificates
COPY aws-cli-pkg-key.asc /tmp/aws-cli-pkg-key.asc
RUN gpg --import /tmp/aws-cli-pkg-key.asc

WORKDIR /tmp

ARG AWSCLI_VER
ENV AWSCLI_VER=$AWSCLI_VER
RUN curl -fsSL -o awscliv2.zip "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m)-${AWSCLI_VER}.zip"
RUN curl -fsSL -o awscliv2.sig "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m)-${AWSCLI_VER}.zip.sig"
RUN gpg --verify awscliv2.sig awscliv2.zip

FROM node:${NODE_VERSION}-bookworm

# python3 replaces the bullseye-era python2 install: Debian 12 (bookworm) no
# longer ships a python2 package, and modern node-gyp (>=9) targets python3.
# apt-get upgrade clears fixable OS-package CVEs the node base carries (Docker
# Scout severity-CVE policy); added when build-js joined the grade-A set (#75).
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install --no-install-recommends -y libltdl-dev rsync zip tini ca-certificates curl apt-transport-https lsb-release gnupg python3 python3-dev groff && \
    rm -rf /var/lib/apt/lists/*
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata

# git-lfs: install the official release binary (built by the git-lfs project on a
# current Go toolchain) instead of Debian's apt package. Debian's git-lfs is built
# with an EOL Go and drags in a cluster of fixable golang/stdlib CRITICAL/HIGH CVEs
# (build-java ships no git-lfs and stayed clean, which is how this surfaced).
# Version from common.config.mk (GIT_LFS_VERSION) via the Makefile build-arg.
ARG GIT_LFS_VERSION
RUN ARCH=$(dpkg --print-architecture) && \
    curl -fsSL -o /tmp/git-lfs.tar.gz \
      "https://github.com/git-lfs/git-lfs/releases/download/v${GIT_LFS_VERSION}/git-lfs-linux-${ARCH}-v${GIT_LFS_VERSION}.tar.gz" && \
    tar -xzf /tmp/git-lfs.tar.gz -C /tmp && \
    install /tmp/git-lfs-*/git-lfs /usr/local/bin/git-lfs && \
    rm -rf /tmp/git-lfs* && \
    git-lfs version

# Docker CLI, built from source in the docker-cli-builder stage above --
# the published static tarball carries an unpatched Go stdlib (#115).
COPY --from=docker-cli-builder /go/bin/docker /usr/local/bin/docker
RUN docker --version

RUN npm install -g npm

ENTRYPOINT ["tini", "--"]

# extra functionality required by pipelines runs (CI)
COPY --from=aws /tmp/awscliv2.zip /tmp/awscliv2.zip
RUN unzip -d /tmp /tmp/awscliv2.zip && /tmp/aws/install && rm -rf /tmp/aws*

RUN curl -sL https://packages.microsoft.com/keys/microsoft.asc | \
  gpg --dearmor | \
  tee /etc/apt/trusted.gpg.d/microsoft.gpg > /dev/null

RUN echo "deb [arch=$(dpkg --print-architecture)] https://packages.microsoft.com/repos/azure-cli/ $(lsb_release -cs) main" | \
  tee /etc/apt/sources.list.d/azure-cli.list

ARG AZCLI_VER
ENV AZCLI_VER=$AZCLI_VER

RUN apt-get update && apt-get install -y azure-cli=${AZCLI_VER}\*

# Default to a non-root user (Docker Scout "default non-root user" policy, #75).
# All installs above run as root; this only affects runtime. BREAKING for any
# downstream expecting root at runtime — consumers pass `-u` or add `USER root`.
# npm global is in /usr/local (world-executable); HOME is writable for the npm/
# node caches the default uid touches.
# No --uid 1000: the node base already has a uid-1000 user (`node`); let useradd
# auto-assign a free uid (still non-root).
RUN useradd --create-home --user-group build
ENV HOME=/home/build
USER build
