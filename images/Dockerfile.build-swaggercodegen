# Maven base: MAVEN_VERSION in common.config.mk (images/Makefile passes it).
ARG MAVEN_VERSION=3.10
FROM maven:${MAVEN_VERSION}-eclipse-temurin-17-noble

# Refuse a JDK older than JAVA_17_MIN_VERSION (common.config.mk). The Maven
# tag names no JDK release, so this guards against a base-image rollback to a
# JDK before the eMudhra (emSign) cacerts fix (#174). The trust store itself is
# made safe by the build-harden kit below and checked by
# images/harden/check/image.sh; this check only keeps the base current.
ARG JAVA_17_MIN_VERSION=17.0.21
RUN v="$(java -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.version = //p')" && \
    echo "java ${v}, need ${JAVA_17_MIN_VERSION} or later" && \
    [ "$(printf '%s\n' "${JAVA_17_MIN_VERSION}" "${v}" | sort -V | head -n 1)" = "${JAVA_17_MIN_VERSION}" ]

# apt-get upgrade clears fixable OS-package CVEs the base image carries (Docker
# Scout severity-CVE policy); added when build-swaggercodegen joined the grade-A
# set (#75).
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install --no-install-recommends -y make tini ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata

COPY --from=swaggerapi/swagger-codegen-cli-v3:3.0.34 /opt/swagger-codegen-cli/swagger-codegen-cli.jar /opt/swagger-codegen-cli.jar

COPY build-swaggercodegen.mk /opt/Dockerfile.swaggercodegen.mk

# Default to a non-root user (Docker Scout "default non-root user" policy, #75).
# Build steps above run as root; this only affects runtime. BREAKING for any
# downstream expecting root at runtime — consumers pass `-u` or add `USER root`.
# HOME is writable so maven's ~/.m2 works for the default uid; the swagger jar
# and .mk are world-readable.
# No --uid 1000: the eclipse-temurin/ubuntu-24.04 base already has a uid-1000
# user (`ubuntu`); let useradd auto-assign a free uid (still non-root).
RUN useradd --create-home --user-group build
ENV HOME=/home/build
# Harden the image with the build-harden kit (images/harden): today it makes
# the image trust no CA in harden/policy/ca-distrust.list (the eMudhra roots
# and intermediates whose keys leaked, CVE-2026-111943). Keep this after the
# last package install; the kit is bind-mounted, so no kit file stays.
RUN --mount=type=bind,source=harden,target=/harden sh /harden/harden.sh

USER build
ENTRYPOINT ["tini", "--", "sh", "-c", "make -f /opt/Dockerfile.swaggercodegen.mk -C $PWD build"]
