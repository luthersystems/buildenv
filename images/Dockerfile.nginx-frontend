# Versions come from common.config.mk; these defaults are fallbacks only.
# 1.27-alpine is an old line on Alpine 3.21, which has no fixed tiff for
# CVE-2026-4775. 1.30 runs on Alpine 3.24, the base the other images use.
ARG NGINX_VERSION=1.30
ARG ALPINE_VERSION=3.24
FROM nginxinc/nginx-unprivileged:${NGINX_VERSION}-alpine${ALPINE_VERSION}

USER root
# Stable floors: curl and libcurl (>= 8.23.0-r0, CVE-2026-92392), zlib
# (>= 1.4-r0, CVE-2026-4738) and libcrypto3 and libssl3 (>= 3.5.9-r1,
# CVE-2026-95691, CVE-2026-95692, CVE-2026-88823, CVE-2026-107496) came from
# edge until 3.24 stable shipped the fix (#207). They now come from stable. The
# floors stay because a base or a mirror that is behind would otherwise give the
# old package with no error; with the floor, apk fails the build. (libexpat
# >= 2.9.0-r0 and libx11 >= 1.8.14-r0, which fixes CVE-2026-88806, have reached
# 3.24 stable; `apk upgrade` picks them up.)
# musl: the patched musl (>= 1.2.6-r6, fixes CVE-2026-107891) is only in alpine
# edge; 3.24 stable still ships 1.2.6-r3. Pull musl and musl-utils from edge
# (Scout reports musl-utils under its source package musl, so an r3 musl-utils
# still reads as the vulnerable musl) until the fix is backported to 3.24
# stable, then drop it. The version floor is needed: a bare musl@edge only
# allows edge, and in this image apk kept the stable r3 without an error.
# nginx: the base ships nginx.org's nginx 1.30.6-r1, which has CVE-2026-123634,
# CVE-2026-123633, CVE-2026-123007, CVE-2026-121810, CVE-2026-113425 and
# CVE-2026-118899 (fixed in 1.30.7). Its modules pin nginx~1.30.6, so
# `apk upgrade` never moves it, and the base doesn't keep nginx.org's repo
# configured. Pull nginx and its modules (only) from nginx.org's signed repo,
# whose key (nginx_signing.rsa.pub) the base already installs. Don't switch to
# Alpine's own nginx package: it is a different build and layout.
# Each package is held to the base's nginx line (~${NGINX_VERSION}), because
# nginx.org's stable repo also gets each new stable line: with only a floor,
# a later rebuild would move the image to, say, 1.32 on a base tagged 1.30.
# `--upgrade` is needed because the base's 1.30.6 already meets ~1.30, and
# without it apk keeps 1.30.6 with no error. The check after it fails the
# build unless `nginx -v` reports at least the CVE floor (nginx_floor). The
# repo line is removed after the install, so a child image's `apk add` needs
# only the Alpine mirrors, not nginx.org. The world pins nginx to the exact
# installed nginx.org version: Alpine main also ships a package named nginx,
# and with a tag-free `nginx~1.30` a child's `apk upgrade` could swap in a
# later Alpine 1.30.x-rN build under nginx.org's modules.
# Limits: the repo path is nginx.org's stable tree, so NGINX_VERSION must be a
# stable (even) line, and nginx.org builds Alpine packages for x86_64 and
# aarch64 only. Drop these lines, nginx_floor with them, once a
# nginx-unprivileged:${NGINX_VERSION}-alpine${ALPINE_VERSION} base ships
# nginx >= 1.30.7.
ARG NGINX_VERSION
ARG ALPINE_VERSION
RUN nginx_floor=1.30.7 && \
  apk update && apk upgrade --no-cache && \
  echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/main" >> /etc/apk/repositories && \
  echo "@nginxorg https://nginx.org/packages/alpine/v${ALPINE_VERSION}/main" >> /etc/apk/repositories && \
  apk add --no-cache 'curl>=8.23.0-r0' 'libcurl>=8.23.0-r0' 'zlib>=1.4-r0' 'libcrypto3>=3.5.9-r1' 'libssl3>=3.5.9-r1' 'musl@edge>=1.2.6-r6' 'musl-utils@edge>=1.2.6-r6' && \
  apk add --no-cache --upgrade "nginx@nginxorg~${NGINX_VERSION}" "nginx-module-geoip@nginxorg~${NGINX_VERSION}" "nginx-module-image-filter@nginxorg~${NGINX_VERSION}" "nginx-module-njs@nginxorg~${NGINX_VERSION}" "nginx-module-xslt@nginxorg~${NGINX_VERSION}" && \
  nginx_installed="$(nginx -v 2>&1 | sed -n 's|^nginx version: nginx/||p')" && \
  [ -n "$nginx_installed" ] && \
  case "$(apk version -t "$nginx_installed" "$nginx_floor")" in '>'|'=') ;; *) echo "nginx $nginx_installed is below $nginx_floor" >&2; exit 1;; esac && \
  nginx_pkgver="$(apk list --installed nginx | sed -n 's/^nginx-\([0-9][^ ]*\) .*/\1/p')" && \
  [ -n "$nginx_pkgver" ] && \
  sed -i '/^@nginxorg /d' /etc/apk/repositories && \
  sed -i -e "s/^nginx@nginxorg~.*/nginx=${nginx_pkgver}/" -e 's/@nginxorg//' /etc/apk/world && \
  grep -qx "nginx=${nginx_pkgver}" /etc/apk/world
# Harden the image with the build-harden kit (images/harden): today it makes
# the image trust no CA in harden/policy/ca-distrust.list (the eMudhra roots
# and intermediates whose keys leaked, CVE-2026-111943). Keep this after the
# last package install; the kit is bind-mounted, so no kit file stays.
RUN --mount=type=bind,source=harden,target=/harden sh /harden/harden.sh

USER nginx

COPY nginx/nginx_serve.sh /opt/
COPY nginx/default.conf.template /etc/nginx/templates/
COPY nginx/nginx.conf /etc/nginx/nginx.conf

VOLUME ["/html"]

ENTRYPOINT ["sh", "/opt/nginx_serve.sh"]

EXPOSE 9090

CMD ["nginx", "-g", "daemon off;"]
