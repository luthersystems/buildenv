# Versions come from common.config.mk; these defaults are fallbacks only.
# 1.27-alpine is an old line on Alpine 3.21, which has no fixed tiff for
# CVE-2026-4775. 1.30 runs on Alpine 3.24, the base the other images use.
ARG NGINX_VERSION=1.30
ARG ALPINE_VERSION=3.24
FROM nginxinc/nginx-unprivileged:${NGINX_VERSION}-alpine${ALPINE_VERSION}

USER root
# curl / libx11: the patched libcurl (>= 8.23.0-r0, fixes CVE-2026-92392) and
# libx11 (>= 1.8.14-r0, fixes CVE-2026-88806) are only in alpine edge; 3.24
# stable still ships the vulnerable 8.22.0-r0 / 1.8.13-r0. Pull these (only)
# from edge until they are backported to 3.24 stable, then drop the edge lines.
# (libexpat >= 2.9.0-r0 has reached 3.24 stable, so it no longer comes from edge.)
RUN apk update && apk upgrade --no-cache && \
  echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/main" >> /etc/apk/repositories && \
  apk add --no-cache curl@edge libcurl@edge libx11@edge
USER nginx

COPY nginx/nginx_serve.sh /opt/
COPY nginx/default.conf.template /etc/nginx/templates/
COPY nginx/nginx.conf /etc/nginx/nginx.conf

VOLUME ["/html"]

ENTRYPOINT ["sh", "/opt/nginx_serve.sh"]

EXPOSE 9090

CMD ["nginx", "-g", "daemon off;"]
