# Versions come from common.config.mk; these defaults are fallbacks only.
# 1.27-alpine is an old line on Alpine 3.21, which has no fixed tiff for
# CVE-2026-4775. 1.30 runs on Alpine 3.24, the base the other images use.
ARG NGINX_VERSION=1.30
ARG ALPINE_VERSION=3.24
FROM nginxinc/nginx-unprivileged:${NGINX_VERSION}-alpine${ALPINE_VERSION}

USER root
# curl: the patched libcurl (>= 8.23.0-r0, fixes CVE-2026-92392) is only in
# alpine edge; 3.24 stable still ships the vulnerable 8.22.0-r0. Pull curl +
# libcurl (only) from edge until backported to 3.24 stable, then drop the edge
# lines. (libexpat >= 2.9.0-r0 and libx11 >= 1.8.14-r0, which fixes
# CVE-2026-88806, have reached 3.24 stable; `apk upgrade` picks them up.)
# musl: the patched musl (>= 1.2.6-r6, fixes CVE-2026-107891) is only in alpine
# edge; 3.24 stable still ships 1.2.6-r3. Pull musl and musl-utils from edge
# (Scout reports musl-utils under its source package musl, so an r3 musl-utils
# still reads as the vulnerable musl) until the fix is backported to 3.24
# stable, then drop it. The version floor is needed: a bare musl@edge only
# allows edge, and in this image apk kept the stable r3 without an error.
# zlib: the patched zlib (>= 1.4-r0, fixes CVE-2026-4738) is only in alpine
# edge; 3.24 stable still ships 1.3.2-r1. Same rule: drop it once backported.
# openssl: the patched openssl (>= 3.5.9-r1, fixes CVE-2026-95691,
# CVE-2026-95692, CVE-2026-88823 and CVE-2026-107496) is only in alpine edge;
# 3.24 stable still ships 3.5.9-r0. Pull libcrypto3 and libssl3 from edge
# (Scout reports them under the source package openssl). Same rule: drop them
# once backported.
# nginx: the base ships nginx.org's nginx 1.30.6-r1, which has CVE-2026-123634,
# CVE-2026-123633, CVE-2026-123007, CVE-2026-121810, CVE-2026-113425 and
# CVE-2026-118899 (fixed in 1.30.7). Its modules pin nginx~1.30.6, so
# `apk upgrade` never moves it, and the base doesn't keep nginx.org's repo
# configured. Pull nginx and its modules (only) from nginx.org's signed repo,
# whose key (nginx_signing.rsa.pub) the base already installs. Don't switch to
# Alpine's own nginx package: it is a different build and layout. Drop these
# lines once a nginx-unprivileged:${NGINX_VERSION}-alpine${ALPINE_VERSION}
# base ships nginx >= 1.30.7.
ARG ALPINE_VERSION
RUN apk update && apk upgrade --no-cache && \
  echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/main" >> /etc/apk/repositories && \
  echo "@nginxorg https://nginx.org/packages/alpine/v${ALPINE_VERSION}/main" >> /etc/apk/repositories && \
  apk add --no-cache curl@edge libcurl@edge 'musl@edge>=1.2.6-r6' 'musl-utils@edge>=1.2.6-r6' 'zlib@edge>=1.4-r0' 'libcrypto3@edge>=3.5.9-r1' 'libssl3@edge>=3.5.9-r1' \
    'nginx@nginxorg>=1.30.7-r1' 'nginx-module-geoip@nginxorg>=1.30.7-r1' 'nginx-module-image-filter@nginxorg>=1.30.7-r1' 'nginx-module-njs@nginxorg>=1.30.7' 'nginx-module-xslt@nginxorg>=1.30.7-r1'
# Harden the image with the build-harden kit (images/harden): today it makes
# the image trust no CA in harden/policy/ca-distrust.list (the eMudhra roots
# and intermediates whose keys leaked, CVE-2026-111943). Keep this after the
# last package install; the kit is bind-mounted, so no kit file stays.
RUN --mount=type=bind,source=harden,target=/harden sh /harden/harden.sh

USER nginx

COPY nginx/nginx_serve.sh /opt/
COPY nginx/default.conf.template /etc/nginx/templates/
COPY nginx/nginx.conf /etc/nginx/nginx.conf

VOLUME ["/html"]

ENTRYPOINT ["sh", "/opt/nginx_serve.sh"]

EXPOSE 9090

CMD ["nginx", "-g", "daemon off;"]
