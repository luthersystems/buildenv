ARG GOLANG_VERSION=1.27.3
ARG ALPINE_VERSION=3.24

#
# aws builder
#

# python:3.11-alpine: awscli's make-exe script still imports `distutils`,
# which Python 3.12 removed (PEP 632), so we stay on 3.11 (EOL Oct 2027).
FROM python:3.11-alpine AS aws

# zlib from edge (>= 1.4-r0, CVE-2026-4738), as in the final stage below:
# make-exe (PyInstaller) copies this stage's libz.so.1 into the AWS CLI bundle,
# so the final stage's apk zlib alone would leave the old one in `aws`. Drop
# it once 3.24 stable has the fix.
RUN set -ex; \
  echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/main" >> /etc/apk/repositories; \
  apk add --no-cache \
  git unzip groff \
  build-base libffi-dev cmake \
  'zlib@edge>=1.4-r0'

ARG AWSCLI_VER
ENV AWSCLI_VER=$AWSCLI_VER

RUN set -eux; \
  mkdir /aws; \
  git clone --single-branch --depth 1 -b ${AWSCLI_VER} https://github.com/aws/aws-cli.git /aws; \
  cd /aws; \
  python -m venv venv; \
  . venv/bin/activate; \
  pip install --no-cache-dir --upgrade wheel==0.46.2; \
  ./scripts/installers/make-exe

RUN set -ex; \
  unzip /aws/dist/awscli-exe.zip; \
  ./aws/install --bin-dir /aws-cli-bin; \
  find /usr/local/aws-cli -path '*/site-packages/wheel' -prune -exec rm -rf {} +; \
  find /usr/local/aws-cli -name 'wheel-*.dist-info' -prune -exec rm -rf {} +; \
  /aws-cli-bin/aws --version

#
# Azure CLI builder
#

FROM alpine:${ALPINE_VERSION} AS azcli

ARG AZCLI_VER
ENV AZCLI_VER=$AZCLI_VER

WORKDIR /az

# certifi 2026.10.19: GHSA-6q48-6c7w-9gw2 (CRITICAL, the compromised eMudhra
# intermediates, CVE-2026-111943). azure-cli (2.92.0 too) does not require a
# certifi version, so the pin keeps pip from resolving an older one.
# pip 26.2.2 vendors certifi 2026.10.19 (the venv's pip 26.2.1 vendors
# 2026.6.17, which Scout reports for the same advisory).
RUN set -ex; \
  apk update; \
  apk upgrade --no-cache; \
  apk add --no-cache \
  build-base libffi-dev openssl-dev cargo python3-dev py3-pip; \
  python3 -m venv ./venv; \
  . ./venv/bin/activate; \
  pip install --no-cache-dir pip==26.2.2; \
  pip install --no-cache-dir azure-cli==${AZCLI_VER} wheel==0.46.2 certifi==2026.10.19

#
# Go utils
#

FROM golang:${GOLANG_VERSION}-alpine${ALPINE_VERSION} AS go-alpine-downloader
# A transient stream reset from proxy.golang.org must cost a re-request, not
# the whole publish (three v0.1.16 attempts died that way -- run 32405801237).
# The | separator falls back to the next entry on ANY error -- including a
# reset mid-download, verified empirically -- and Go does not dedupe the list,
# so listing the same proxy three times is a native two-shot retry against
# itself. No `direct` tail: VCS fallback would hit GitHub rate limits and can
# only serve a strict subset of what the proxy serves. Builder stage only --
# the final image's GOPROXY is downstream users' business, not ours.
ENV GOPROXY="https://proxy.golang.org|https://proxy.golang.org|https://proxy.golang.org"

ARG GO_BINDATA_VERSION
RUN go install "github.com/go-bindata/go-bindata/v3/go-bindata@v${GO_BINDATA_VERSION}"
ARG GO_TESTSUM_VERSION
# Built from source (not `go install`) so the go get below can raise transitive
# deps gotestsum would otherwise bundle at vulnerable versions. Trade-off:
# `gotestsum --version` reports "(devel)" -- it has no version ldflag and
# derives its version from the main module.
# GO_PIN_* versions, and the CVEs each one clears: common.config.mk.
ARG GO_PIN_X_MOD
ARG GO_PIN_X_SYS
ARG GO_PIN_X_TEXT
RUN mkdir /tmp/gotestsum && cd /tmp/gotestsum && \
    go mod init _gotestsum && \
    go get "gotest.tools/gotestsum@v${GO_TESTSUM_VERSION}" golang.org/x/mod@v${GO_PIN_X_MOD} golang.org/x/sys@v${GO_PIN_X_SYS} golang.org/x/text@v${GO_PIN_X_TEXT} && \
    go build -o /go/bin/gotestsum "gotest.tools/gotestsum" && \
    cd / && rm -rf /tmp/gotestsum
ARG GOLANGCI_LINT_VERSION
# Built from source (not `go install`) so the go get below can raise transitive
# deps golangci-lint would otherwise bundle at vulnerable versions. The ldflags
# preserve `--version` (golangci-lint uses build-info only when main.date is
# empty).
# GO_PIN_* versions, and the CVEs each one clears: common.config.mk.
ARG GO_PIN_X_MOD
ARG GO_PIN_X_SYS
ARG GO_PIN_X_TEXT
RUN mkdir /tmp/golangci && cd /tmp/golangci && \
    go mod init _golangci && \
    go get "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v${GOLANGCI_LINT_VERSION}" golang.org/x/mod@v${GO_PIN_X_MOD} golang.org/x/sys@v${GO_PIN_X_SYS} golang.org/x/text@v${GO_PIN_X_TEXT} && \
    go build -ldflags "-X main.version=${GOLANGCI_LINT_VERSION} -X main.commit=unknown -X main.date=unknown" \
      -o /go/bin/golangci-lint "github.com/golangci/golangci-lint/v2/cmd/golangci-lint" && \
    cd / && rm -rf /tmp/golangci
ARG GIT_LFS_VERSION
# Built from source so the go get below can raise transitive deps the tool
# would otherwise bundle at vulnerable versions.
# GO_PIN_* versions, and the CVEs each one clears: common.config.mk.
ARG GO_PIN_X_CRYPTO
ARG GO_PIN_X_NET
ARG GO_PIN_X_SYS
RUN apk add --no-cache gcc git musl-dev && \
    mkdir /tmp/gitlfs && cd /tmp/gitlfs && \
    go mod init _gitlfs && \
    go get "github.com/git-lfs/git-lfs/v3@v${GIT_LFS_VERSION}" golang.org/x/crypto@v${GO_PIN_X_CRYPTO} golang.org/x/net@v${GO_PIN_X_NET} golang.org/x/sys@v${GO_PIN_X_SYS} && \
    go build -o /go/bin/git-lfs "github.com/git-lfs/git-lfs/v3" && \
    cd / && rm -rf /tmp/gitlfs

ARG DOCKER_CLI_VERSION
# Built from source, not the download.docker.com static tarball: Docker builds
# its published CLI with whatever Go release it happened to use, so stdlib CVEs
# fixed in later Go releases ride along in the prebuilt binary and no
# DOCKER_CLI_VERSION bump can clear them (#115). Building here links the
# GOLANG_VERSION stdlib instead, and the go get below raises vulnerable
# transitive deps. CGO_ENABLED=0 with osusergo,netgo keeps the binary static
# (as the tarball was) and avoids a gcc/musl-dev dependency in the Alpine
# variants; the ldflags preserve `docker --version`.
# GO_PIN_* versions, and the CVEs each one clears: common.config.mk.
ARG GO_PIN_GRPC
ARG GO_PIN_X_NET
ARG GO_PIN_GO_JOSE
ARG GO_PIN_KLAUSPOST_COMPRESS
RUN mkdir /tmp/dockercli && cd /tmp/dockercli && \
    go mod init _dockercli && \
    go get "github.com/docker/cli/cmd/docker@v${DOCKER_CLI_VERSION}" google.golang.org/grpc@v${GO_PIN_GRPC} golang.org/x/net@v${GO_PIN_X_NET} github.com/go-jose/go-jose/v4@v${GO_PIN_GO_JOSE} github.com/klauspost/compress@v${GO_PIN_KLAUSPOST_COMPRESS} && \
    CGO_ENABLED=0 go build -tags "grpcnotrace,osusergo,netgo" \
      -ldflags "-X github.com/docker/cli/cli/version.Version=${DOCKER_CLI_VERSION} -X github.com/docker/cli/cli/version.GitCommit=unknown -X github.com/docker/cli/cli/version.BuildTime=unknown -X github.com/docker/cli/cli/version.PlatformName=Docker" \
      -o /go/bin/docker "github.com/docker/cli/cmd/docker" && \
    cd / && rm -rf /tmp/dockercli

ARG DOCKER_COMPOSE_VERSION
# Built from source so the go get below can raise transitive deps the tool
# would otherwise bundle at vulnerable versions.
# GO_PIN_* versions, and the CVEs each one clears: common.config.mk.
ARG GO_PIN_GRPC
ARG GO_PIN_MOBY_GO_ARCHIVE
ARG GO_PIN_X_CRYPTO
ARG GO_PIN_X_NET
ARG GO_PIN_CONTAINERD
RUN mkdir /tmp/compose && cd /tmp/compose && \
    go mod init _compose && \
    go get "github.com/docker/compose/v5/cmd@v${DOCKER_COMPOSE_VERSION}" google.golang.org/grpc@v${GO_PIN_GRPC} github.com/moby/go-archive@v${GO_PIN_MOBY_GO_ARCHIVE} golang.org/x/crypto@v${GO_PIN_X_CRYPTO} golang.org/x/net@v${GO_PIN_X_NET} github.com/containerd/containerd/v2@v${GO_PIN_CONTAINERD} github.com/klauspost/compress@v${GO_PIN_KLAUSPOST_COMPRESS} && \
    go build -o /go/bin/docker-compose "github.com/docker/compose/v5/cmd" && \
    cd / && rm -rf /tmp/compose

#
# Godynamic
#

FROM alpine:$ALPINE_VERSION

CMD ["/bin/sh"]
RUN test -e /etc/nsswitch.conf || echo "hosts: files dns" >/etc/nsswitch.conf

ENV GOPATH=/go
ENV GOCACHE=/tmp
ENV PATH=/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /go

RUN mkdir -p "$GOPATH/src" "$GOPATH/bin" && chmod -R 777 "$GOPATH" && \
  apk update && \
  apk upgrade --no-cache && \
  apk add --no-cache ca-certificates tzdata libltdl rsync zip openssh git bash shadow gcc musl-dev make linux-headers curl tini gcompat python3-dev py3-pip groff openrc

# curl: the patched libcurl (>= 8.23.0-r0, fixes CVE-2026-92392) is only in
# alpine edge; 3.24 stable still ships the vulnerable 8.22.0-r0. Pull curl +
# libcurl (only) from edge via a tagged repo until the fix is backported to 3.24
# stable, then drop this. The @edge tag scopes edge to those two packages;
# everything else stays stable. (jq >= 1.8.2-r0 and libexpat >= 2.9.0-r0 have
# reached 3.24 stable, so they no longer come from edge.)
# musl: the patched musl (>= 1.2.6-r6, fixes CVE-2026-107891) is only in alpine
# edge; 3.24 stable still ships 1.2.6-r3. Pull musl, musl-dev and musl-utils
# from edge: Scout reports a subpackage under its source package musl, so a
# musl-utils left at r3 still reads as the vulnerable musl. Keep them until
# the fix is backported to 3.24 stable, then drop them.
# rsync: the patched rsync (>= 3.5.2-r0, fixes CVE-2026-119741) is only in alpine
# edge; 3.24 stable still ships 3.5.0-r0. Same rule: drop it once backported.
# zlib: the patched zlib (>= 1.4-r0, fixes CVE-2026-4738) is only in alpine
# edge; 3.24 stable still ships 1.3.2-r1. Same rule: drop it once backported.
RUN echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/main" >> /etc/apk/repositories && \
  apk add --no-cache jq curl@edge libcurl@edge 'musl@edge>=1.2.6-r6' 'musl-dev@edge>=1.2.6-r6' 'musl-utils@edge>=1.2.6-r6' 'rsync@edge>=3.5.2-r0' 'zlib@edge>=1.4-r0'

# Docker CLI, built from source in the go-alpine-downloader stage above --
# the published static tarball carries an unpatched Go stdlib (#115).
COPY --from=go-alpine-downloader /go/bin/docker /usr/local/bin/docker
RUN docker --version

RUN mkdir -p /usr/local/lib/docker/cli-plugins

COPY --from=go-alpine-downloader /go/bin/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose

RUN chmod +x /usr/local/lib/docker/cli-plugins/docker-compose && \
    ln -sf /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose && \
    docker compose version && \
    docker-compose version

ENTRYPOINT ["tini", "--"]

# set up private repo access for go mod
RUN git config --system url."git@github.com:luthersystems/license.git".insteadOf "https://github.com/luthersystems/license"; \
  git config --system url."git@github.com:luthersystems/substrate.git".insteadOf "https://github.com/luthersystems/substrate"; \
  git config --system url."git@github.com:luthersystems/chainidentifier.git".insteadOf "https://github.com/luthersystems/chainidentifier"; \
  ssh-keyscan -t Ed25519 -H bitbucket.org | tee -a /etc/ssh/ssh_known_hosts; \
  ssh-keyscan -t Ed25519 -H github.com | tee -a /etc/ssh/ssh_known_hosts

COPY --from=go-alpine-downloader /usr/local/go/ /usr/local/go/
COPY --from=go-alpine-downloader /go/bin/go-bindata /go/bin/go-bindata
COPY --from=go-alpine-downloader /go/bin/gotestsum /go/bin/gotestsum
COPY --from=go-alpine-downloader /go/bin/golangci-lint /go/bin/golangci-lint
COPY --from=go-alpine-downloader /go/bin/git-lfs /go/bin/git-lfs
COPY --from=aws /usr/local/aws-cli/ /usr/local/aws-cli/
COPY --from=aws /aws-cli-bin/ /usr/local/bin/
COPY --from=azcli /az /az

ENV PATH="/az/venv/bin:$PATH"

# Default to a non-root user (Docker Scout "default non-root user" policy, #75).
# Everything above runs as root; this only affects runtime. GOPATH (/go) is mode
# 777 and GOCACHE=/tmp, so a non-root uid can run go builds; HOME is writable;
# the aws/az CLIs in /usr/local + /az are world-executable. BREAKING for any
# downstream `FROM` consumer (it writes root-owned cache mounts) — that stage
# must declare `USER root` (the build-go-alpine pattern).
RUN addgroup -g 1000 build && adduser -D -u 1000 -G build -h /home/build build
ENV HOME=/home/build
# Harden the image with the build-harden kit (images/harden): today it makes
# the image trust no CA in harden/policy/ca-distrust.list (the eMudhra roots
# and intermediates whose keys leaked, CVE-2026-111943). Keep this after the
# last package install; the kit is bind-mounted, so no kit file stays.
RUN --mount=type=bind,source=harden,target=/harden sh /harden/harden.sh

USER build
